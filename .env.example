# Media Server Configuration
# Copy this file to .env and update the values

# =============================================================================
# Application Ports
# =============================================================================

# Media Server
JELLYFIN_PORT=8096

# Download Client
QBITTORRENT_PORT=8080

# *arr Applications
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696

# Add-on Services
BAZARR_PORT=6767
OVERSEERR_PORT=5055
PORTAINER_PORT=9000

# Reverse Proxy
TRAEFIK_DASHBOARD_PORT=8081

# =============================================================================
# System Configuration
# =============================================================================

# User/Group IDs (find with: id -u && id -g)
PUID=1000
PGID=1000

# Timezone (list: timedatectl list-timezones)
TZ=Asia/Kolkata

# Data Path - Where all media and configs are stored
# TRaSH Guide recommended structure:
#   DATA_PATH/
#   ├── config/          # Application configs
#   ├── media/           # Movies, TV shows
#   │   ├── movies/
#   │   └── tv/
#   └── torrents/        # Downloads
#       ├── movies/
#       └── tv/
DATA_PATH=/home/yourusername/data

# =============================================================================
# Optional: VPN Configuration (for Gluetun)
# Uncomment and configure if using VPN
# =============================================================================

# VPN_TYPE=wireguard
# VPN_ENDPOINT=your.vpn.provider.com
# VPN_PORT=51820
# VPN_PUBLIC_KEY=your_public_key
# VPN_PRIVATE_KEY=your_private_key
# VPN_ADDRESS=10.0.0.2/24
